# Copy this file to .env before running:  cp .env.example .env

# PostgreSQL
POSTGRES_USER=washtag
POSTGRES_PASSWORD=washtag_secret
POSTGRES_DB=washtagdb

# JWT signing secret — use a long random string in production
JWT_SECRET=washtagbd-development-secret-change-this-in-production-2026

# Port where the app will be available on your machine
APP_PORT=8081

# Seed a demo shop, staff user, customers and sample orders on first run
SEED_DEMO_DATA=true

# Optional: enable LLM phrasing for the AI Shop Assistant.
# Leave blank to run fully offline with local embeddings + grounded answers.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
