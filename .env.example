# Copy this file to .env before running:  cp .env.example .env

# PostgreSQL
POSTGRES_USER=washtag
POSTGRES_PASSWORD=washtag_secret
POSTGRES_DB=washtagdb

# JWT signing secret — use a long random string in production
JWT_SECRET=washtagbd-development-secret-change-this-in-production-2026

# Port where the app will be available on your machine
APP_PORT=8081

# Seed a demo shop, staff user, customers and sample orders on first run
SEED_DEMO_DATA=true

# Optional: enable LLM phrasing for the AI Shop Assistant.
# Leave blank to run fully offline with local embeddings + grounded answers.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Or use an AI Gateway token instead of a direct OpenAI key (offline mode stays default)
AI_GATEWAY_TOKEN=
AI_GATEWAY_URL=https://ai.gateway.vercel.app/v1
AI_GATEWAY_EMBEDDING_MODEL=text-embedding-3-small
AI_GATEWAY_CHAT_MODEL=gpt-4o-mini

# Optional: fixed public origin used inside QR codes (e.g. https://wash.example.com).
# Recommended in production so QR links never depend on request Host headers.
PUBLIC_BASE_URL=

# Comma-separated list of origins allowed by CORS (use your real domain in production)
ALLOWED_ORIGINS=http://localhost:8081

# Comma-separated emails that get platform-admin access
ADMIN_EMAILS=demo@washtagbd.com

# Set to true to enable interactive API docs at /swagger
ENABLE_SWAGGER=false

# Scheduled housekeeping (in-process background worker, one run per interval)
# Marks overdue invoices/expired subscriptions, prunes old chat and refresh tokens,
# and reindexes shop documents so stale vectors are removed.
# Set false in production so only a platform admin can settle invoices (no gateway verification exists)
MANUAL_PAYMENT_ENABLED=true
MAINTENANCE_ENABLED=true
MAINTENANCE_INTERVAL_MINUTES=60
MAINTENANCE_RUN_ON_STARTUP=false
MAINTENANCE_CHAT_RETENTION_DAYS=90
